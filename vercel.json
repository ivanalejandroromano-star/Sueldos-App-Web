{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python@4.3.0"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/logo.png",
      "dest": "public/logo.png"
    },
    {
      "src": "/sueldos.db",
      "dest": "public/sueldos.db"
    },
    {
      "src": "/(.*)",
      "dest": "public/index.html"
    }
  ]
}
